# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit it, and never paste a real key into
# tracked files (quickstart.py, notebooks, etc.).

# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: a Hugging Face token to raise rate limits when downloading the
# NLI model / TruthfulQA dataset (silences the "unauthenticated requests" warning).
# HF_TOKEN=

# Optional: silence the tokenizers fork warning seen on Python 3.12.
# TOKENIZERS_PARALLELISM=false
